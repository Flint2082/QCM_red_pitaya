# List of untracked files to ignore

.claude/*
.venv*
*.pyc
*__pycache__*
*.Xil*
*.egg*

# Server-side run and sweep logs written at runtime
data/runs/
data/sweeps/

# FPGA toolflow output (System Generator / CASPER), regenerated on every build
SysgenFeatureReport.htm
*_sysgen*.log
model_composer/log.log
model_composer/slprj/
*.slxc
*.slx.autosave
*.slx.original
model_composer/qcm_rp/*
!model_composer/qcm_rp/outputs/
# Only the .fpg built with bitstream/top.bit.bin is tracked, because the server
# loads the newest one as its register map; tools/generate_and_push.sh
# force-adds it and untracks the previous one.
model_composer/qcm_rp/outputs/*.fpg

# Runtime state written by the server, not source
data/settings.json
data/calibration/

# Altium Designer leftovers: auto-backups on every save, ECO logs from every
# schematic-to-PCB update, and the schematic thumbnail cache
Hardware/**/History/
Hardware/**/Project Logs for */
Hardware/**/__Previews/
# Generated fab outputs: only the zip sent to the fab is versioned; it holds
# every loose Gerber/drill/report file next to it
Hardware/**/Project Outputs for */*
!Hardware/**/Project Outputs for */*.zip
