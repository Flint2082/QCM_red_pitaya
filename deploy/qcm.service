[Unit]
Description=QCM Red Pitaya measurement service
# Wait for the network so the REST/WebSocket server and the OPC-UA bridge can bind/connect.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root is required: the program memory-maps /dev/mem and loads the FPGA bitstream via fpgautil.
User=root
# Must run from src/ so that src/ is on sys.path for the package imports
# (domain, api, app, ...). The bitstream is found relative to the source file,
# not the working directory, so only the imports depend on this.
WorkingDirectory=/root/QCM_red_pitaya/src
ExecStart=/root/QCM_red_pitaya/.venv/bin/python main.py
# The OPC-UA bridge to the WAGO PLC is off until it is switched on under
# Settings -> OPC-UA; --no-opcua on the line above leaves it out entirely.

# Keep it alive across crashes / hardware hiccups.
Restart=always
RestartSec=5

# Logs go to the journal: view with `journalctl -u qcm -f`.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=qcm

[Install]
WantedBy=multi-user.target
